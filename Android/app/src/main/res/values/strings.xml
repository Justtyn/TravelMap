    <string name="project_info_title">TravelMap · 项目说明</string>
    <string name="project_info_developer_title">开发者说明</string>
    <string name="project_info_developer_desc">焦梓豪，厦门大学嘉庚学院信息科学学院软件工程专业学生。个人安卓期末课程设计 Demo，由个人独立完成需求分析、界面设计、网络层、业务实现及后端联调。常驻 GitHub：https://github.com/Justtyn ，个人博客：https://justtyn.github.io/ 。</string>
    <string name="project_info_software_title">软件说明</string>
    <string name="project_info_software_desc">TravelMap 致力于提供景点推荐、商城、预订与个人行程管理体验，实现统一登录、收藏/去过、购物车、订单等核心流程。本 Demo 重点验证了 Android 端的 Material3 设计、Amap 地图、微信登录与分享链路。</string>
    <string name="project_info_log_title">项目开发日志</string>
    <string name="project_info_log_desc">• 2024-10：完成基础架构、Feed 列表与详情页；\n• 2024-11：打通购物车、订单、个人资料等“我的”模块；\n• 2024-12：接入微信登录/分享，补全课程汇报所需的项目说明与链接。\n\n更多细节可在仓库 DEV_LOG.md 中查看。</string>
